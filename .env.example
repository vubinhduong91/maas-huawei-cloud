# ---------------------------------------------------------------------------
# Huawei MaaS (Anthropic-compatible endpoint)
# ---------------------------------------------------------------------------
# Base URL Anthropic-compatible của Huawei MaaS (không kèm /v1; Claude Code tự nối /v1/messages).
# Giá trị dưới lấy từ tài liệu Huawei (region CN-Hong Kong, pay-per-use), xem ASSUMPTIONS.md.
# CẦN XÁC NHẬN với khách hàng: họ dùng endpoint này hay Token Plan (https://api.modelarts-maas.com/plan/anthropic).
MAAS_BASE_URL=https://api-ap-southeast-1.modelarts-maas.com/anthropic
MAAS_API_KEY=

# Header MaaS nhận API key. Tài liệu Huawei ghi cả hai kiểu (x-api-key và Authorization: Bearer);
# hướng dẫn Claude Code của Huawei dùng ANTHROPIC_AUTH_TOKEN => Authorization: Bearer.
# Chạy scripts/probe-maas.sh để kiểm chứng kiểu nào thực sự hoạt động.
# Kiểu còn lại: MAAS_AUTH_HEADER=x-api-key + MAAS_AUTH_SCHEME= (để trống)
MAAS_AUTH_HEADER=Authorization
MAAS_AUTH_SCHEME=Bearer

# Tên model trên MaaS (tài liệu liệt kê: glm-5.3, glm-5.2, glm-5.1, deepseek-v4-*).
MAAS_MODEL_MAIN=glm-5.2
# Model cho tier haiku/background (prod chưa có model Huawei cho tier này)
MAAS_MODEL_FAST=glm-5.2

# Context window of MAAS_MODEL_MAIN (GLM-5.3: 1M). Claude Code assumes 200K for models it
# does not know and would auto-compact early; scripts/run-claude.sh passes this through
# CLAUDE_CODE_MAX_CONTEXT_TOKENS.
MAAS_MAX_CONTEXT_TOKENS=1000000

# ---------------------------------------------------------------------------
# Lab
# ---------------------------------------------------------------------------
# Key giả lập cho từng developer: <consumer>:<key>,...
DEV_KEYS=dev_alice:key-alice-123,dev_bob:key-bob-456

# Image APISIX (standalone). Ghim version để lab tái lập được.
APISIX_IMAGE_TAG=3.11.0-debian

# Admin key of the view-only dashboard mirror (make dashboard); generated into .env if empty.
DASHBOARD_ADMIN_KEY=

# Host address the lab ports (9080 APISIX, 9091 tap, 9180 dashboard) bind to.
# On a server with a public IP set 127.0.0.1 and reach the ports through `ssh -L`.
LAB_BIND=0.0.0.0
