# Template for conf/apisix.yaml. Placeholders use @@{NAME} and are filled by render.py.
# The rendered file contains MAAS_API_KEY: it lives only in a docker volume.
upstreams:
  - id: maas
    type: roundrobin
    # Mode A/C: nodes = MaaS. Mode B: nodes = tap (http), Host header still MaaS.
    scheme: @{NODE_SCHEME}
    pass_host: rewrite
    upstream_host: @{UPSTREAM_HOST}
    nodes:
      - host: @{NODE_HOST}
        port: @{NODE_PORT}
        weight: 1
    timeout:
      connect: 10
      send: 600
      read: 600
@{ANTHROPIC_UPSTREAM}
routes:
  - id: anthropic-messages
    uris:
      - /v1/messages
      - /v1/messages/count_tokens
    methods:
      - POST
    upstream_id: maas
    plugins:
      serverless-pre-function:
        phase: rewrite
        functions:
          - |
            return function(conf, ctx)
              -- Developer key, first found of: X-Lab-Key (sent through ANTHROPIC_CUSTOM_HEADERS
              -- when Claude Code is logged in with a Claude subscription), x-api-key
              -- (ANTHROPIC_API_KEY), Authorization: Bearer (ANTHROPIC_AUTH_TOKEN).
              -- key-auth reads x-api-key. The client Authorization is dropped here;
              -- proxy-rewrite sets the MaaS one. The body is never modified.
              -- APISIX runs rewrite-phase plugins again after key-auth found the consumer
              -- ("rewrite_in_consumer"); by then the headers are already rewritten, so run once.
              if ctx.lab_pre_done then
                return
              end
              ctx.lab_pre_done = true
              local core = require("apisix.core")
              local PASSTHROUGH = @{PASSTHROUGH_LUA}
              local auth = core.request.header(ctx, "authorization")
              core.request.set_header(ctx, "x-lab-target", nil)   -- never trust it from the client
              if PASSTHROUGH then
                -- Claude models go to api.anthropic.com with the client's own token
                -- (traffic-split + serverless-post-function below); GLM models go to MaaS.
                local body = core.request.get_body(nil, ctx)
                local ok, req = pcall(core.json.decode, body or "")
                local model = ok and type(req) == "table" and req.model
                if type(model) == "string" and model:sub(1, 7) == "claude-" then
                  ctx.lab_target = "anthropic"
                  ctx.lab_client_auth = auth
                  core.request.set_header(ctx, "x-lab-target", "anthropic")
                end
              end
              local key = core.request.header(ctx, "x-lab-key") or core.request.header(ctx, "x-api-key")
              if not key and auth then
                key = auth:match("^[Bb]earer%s+(%S+)%s*$")
              end
              core.request.set_header(ctx, "x-lab-key", nil)
              if key then
                core.request.set_header(ctx, "x-api-key", key)
              end
              core.request.set_header(ctx, "authorization", nil)
              -- Key-order lab profiles P2 / P2S: decode the body and set it again, re-encoded
              -- as a body-touching plugin would. P2: core.json.encode (lua-cjson, key order not
              -- kept). P2S: core.json.stably_encode (dkjson, keys sorted: same input, same bytes).
              if @{REENCODE_LUA} then
                local raw = core.request.get_body(nil, ctx)
                local ok, req = pcall(core.json.decode, raw or "")
                if ok and type(req) == "table" then
                  local out = @{REENCODE_FN}(req)
                  if out then
                    ngx.req.set_body_data(out)
                  end
                end
              end
            end
      key-auth:
        header: x-api-key
        hide_credentials: true
      proxy-rewrite:
        regex_uri: @{REGEX_URI}
        headers:
          set: @{HEADERS_SET}
@{HEADERS_REMOVE}
@{PASSTHROUGH_PLUGINS}
@{AI_PROXY}
      file-logger:
        path: /usr/local/apisix/logs/lab/requests.log
        # With log_format set, APISIX 3.11 ignores include_req_body/max_req_body_bytes and
        # the body comes only from "$request_body" below (see client_body_buffer_size in
        # config.yaml). Kept for when log_format is removed.
        include_req_body: true
        max_req_body_bytes: 16777216
        # Explicit format: request headers are NOT logged, so neither the developer
        # key nor the injected MAAS key can end up in the log.
        log_format:
          ts: "$time_iso8601"
          request_id: "$request_id"
          client_ip: "$remote_addr"
          consumer: "$consumer_name"
          route_id: "$route_id"
          method: "$request_method"
          request_uri: "$request_uri"
          upstream_uri: "$upstream_uri"
          status: "$status"
          request_length: "$request_length"
          content_length: "$http_content_length"
          bytes_sent: "$bytes_sent"
          request_time: "$request_time"
          upstream_addr: "$upstream_addr"
          upstream_status: "$upstream_status"
          upstream_connect_time: "$upstream_connect_time"
          upstream_header_time: "$upstream_header_time"
          upstream_response_time: "$upstream_response_time"
          anthropic_version: "$http_anthropic_version"
          anthropic_beta: "$http_anthropic_beta"
          user_agent: "$http_user_agent"
          claude_code_session_id: "$http_x_claude_code_session_id"
          request_body: "$request_body"

consumers:
@{CONSUMERS}
#END
