{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/memory-sync.sh\"", "timeout": 30, "statusMessage": "Syncing memory..." }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/memory-sync.sh\"", "timeout": 30 }
        ]
      }
    ]
  }
}
